NODE_ENV=development
PORT=4000

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://padosipro:padosipro_dev@localhost:5432/padosipro?schema=public"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Secret used to HMAC OTP codes before storing them (min 32 chars)
OTP_HMAC_SECRET=change-me-to-another-random-string-of-32-plus-chars

# OTP rules
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"